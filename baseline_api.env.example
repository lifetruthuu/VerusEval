# Copy this file to baseline_api.env and fill in the key.
# Both baselines use https://api.openai.com/v1 by default.

# Recommended when AlphaVerus and AutoVerus share one provider account:
BASELINE_API_KEY=

# Optional per-baseline overrides. Leave blank to use BASELINE_API_KEY.
OPENAI_API_KEY=
ALPHAVERUS_API_KEY=

# Optional endpoint/model overrides:
OPENAI_BASE_URL=https://api.openai.com/v1
ALPHAVERUS_API_BASE=https://api.openai.com/v1
ALPHAVERUS_MODEL=llama-3.3-70b
