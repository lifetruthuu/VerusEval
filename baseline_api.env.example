# Optional local credentials. Copy to baseline_api.env (ignored by Git).
# Export these values on the host and pass each required variable to Docker with -e.
# The unified run_dataset.py entry reads environment variables; it does not load this file.

# Shared credentials for an OpenAI-compatible service:
BASELINE_API_KEY=

# OPENAI_API_KEY is also accepted by all four launchers.
OPENAI_API_KEY=
ALPHAVERUS_API_KEY=

# Endpoint for the shared service; replace with your provider's URL.
OPENAI_BASE_URL=https://api.openai.com/v1
ALPHAVERUS_API_BASE=https://api.openai.com/v1
# Provider IDs can be overridden with --api-model on the unified entry.
# Optional model-specific variables used by generation.json:
GENERATION_DEEPSEEK_CHAT_API_KEY=
GENERATION_DEEPSEEK_CHAT_BASE_URL=
